# With a key, the backend defaults to Meta mode. Set fake only for explicit demo simulation.
# CARMORI_SPARK=fake
META_API_BASE_URL=https://api.meta.ai/v1
META_API_KEY=
SPARK_VISION_MODEL=muse-spark-1.3
SPARK_TIMEOUT_S=20
# Step observations: minimal|low|medium|high (empty = model default). Lower is faster.
SPARK_REASONING_EFFORT=minimal

# Optional persistence path (default: backend/data/carmori.sqlite)
# CARMORI_DB_PATH=/absolute/path/to/carmori.sqlite
CARMORI_CORS_ORIGINS=http://localhost:5173,https://localhost:5173
